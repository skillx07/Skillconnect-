<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SkillConnect</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f7fb;
    color:#172033;
    min-height:100vh;
}

button{
    cursor:pointer;
    border:none;
}

.hidden{
    display:none!important;
}


/* AUTH */

#authPage{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:linear-gradient(135deg,#eef4ff,#ffffff);
}

.auth-card{
    width:100%;
    max-width:430px;
    background:white;
    padding:35px 25px;
    border-radius:24px;
    box-shadow:0 10px 35px rgba(0,0,0,.10);
    text-align:center;
}

.logo{
    width:75px;
    height:75px;
    border-radius:20px;
    background:#2563eb;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:35px;
    font-weight:bold;
    margin:0 auto 18px;
}

.auth-card h1{
    font-size:30px;
    margin-bottom:8px;
}

.tagline{
    color:#64748b;
    margin-bottom:30px;
    line-height:1.5;
}

.auth-buttons{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.primary-btn,
.secondary-btn{
    width:100%;
    padding:15px;
    border-radius:12px;
    font-size:16px;
    font-weight:bold;
}

.primary-btn{
    background:#2563eb;
    color:white;
}

.secondary-btn{
    background:#eaf1ff;
    color:#2563eb;
}


/* FORM */

.form-page{
    min-height:100vh;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.form-card{
    width:100%;
    max-width:430px;
    background:white;
    padding:28px 22px;
    border-radius:22px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.form-card h2{
    margin-bottom:20px;
    text-align:center;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    margin-bottom:7px;
    font-weight:bold;
    font-size:14px;
}

.form-group input,
.form-group select,
.form-group textarea{
    width:100%;
    padding:13px;
    border:1px solid #d8dee9;
    border-radius:10px;
    outline:none;
    font-size:15px;
}

.form-group textarea{
    min-height:100px;
    resize:vertical;
}

.form-actions{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-top:20px;
}

.back-btn{
    background:#f1f5f9;
    color:#334155;
    padding:13px;
    border-radius:10px;
    font-weight:bold;
}


/* APP */

#appPage{
    display:none;
    min-height:100vh;
    padding-bottom:80px;
}

.app-header{
    background:white;
    padding:17px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 2px 10px rgba(0,0,0,.06);
    position:sticky;
    top:0;
    z-index:10;
}

.app-logo{
    font-size:22px;
    font-weight:bold;
    color:#2563eb;
}

.logout-btn{
    background:#fee2e2;
    color:#dc2626;
    padding:9px 13px;
    border-radius:9px;
    font-weight:bold;
}

.container{
    width:100%;
    max-width:1000px;
    margin:auto;
    padding:20px;
}

.welcome-box{
    background:#2563eb;
    color:white;
    padding:24px;
    border-radius:20px;
    margin-bottom:22px;
}

.welcome-box h2{
    margin-bottom:8px;
}

.welcome-box p{
    opacity:.9;
}


/* SEARCH */

.search-box{
    background:white;
    padding:15px;
    border-radius:15px;
    margin-bottom:20px;
    box-shadow:0 5px 15px rgba(0,0,0,.05);
}

.search-box input{
    width:100%;
    border:1px solid #dbe2ea;
    border-radius:10px;
    padding:14px;
    font-size:15px;
    outline:none;
}


/* CATEGORIES */

.section-title{
    margin-bottom:15px;
    font-size:21px;
}

.category-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:13px;
}

.category-card{
    background:white;
    border-radius:17px;
    padding:20px 10px;
    text-align:center;
    box-shadow:0 5px 16px rgba(0,0,0,.06);
}

.category-icon{
    font-size:35px;
    margin-bottom:9px;
}

.category-card h3{
    font-size:15px;
}


/* APP SECTIONS */

.app-section{
    display:none;
    background:white;
    padding:22px;
    border-radius:20px;
    margin-top:20px;
    box-shadow:0 5px 18px rgba(0,0,0,.06);
}

.app-section h2{
    margin-bottom:7px;
}

.section-description{
    color:#64748b;
    margin-bottom:20px;
    line-height:1.5;
}
/* WORKER REQUEST */

.worker-card{
    background:#f8fafc;
    padding:18px;
    border-radius:15px;
    margin-bottom:15px;
    border:1px solid #e2e8f0;
}

.worker-info{
    display:flex;
    align-items:center;
    gap:13px;
    margin-bottom:15px;
}

.worker-avatar{
    width:55px;
    height:55px;
    border-radius:50%;
    background:#dbeafe;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
}

.worker-name{
    font-weight:bold;
    font-size:17px;
}

.rating{
    margin-top:4px;
    font-size:14px;
}

.action-row{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.action-row button{
    flex:1;
    min-width:120px;
    padding:12px;
    border-radius:10px;
    font-weight:bold;
}

.accept-btn{
    background:#16a34a;
    color:white;
}

.reject-btn{
    background:#fee2e2;
    color:#dc2626;
}


/* SERVICE DETAILS */

.selected-service{
    background:#eff6ff;
    color:#1d4ed8;
    padding:14px;
    border-radius:12px;
    margin-bottom:15px;
    font-weight:bold;
}


/* INSPECTION */

.inspection-box{
    background:#f8fafc;
    padding:18px;
    border-radius:15px;
    border:1px solid #e2e8f0;
}

.inspection-status{
    padding:12px;
    border-radius:10px;
    background:#fff7ed;
    color:#c2410c;
    margin-bottom:15px;
    font-weight:bold;
}


/* QUOTE */

.quote-box{
    background:#f8fafc;
    border-radius:15px;
    padding:18px;
    border:1px solid #e2e8f0;
}

.quote-item{
    display:flex;
    justify-content:space-between;
    padding:10px 0;
    border-bottom:1px solid #e2e8f0;
}

.quote-total{
    display:flex;
    justify-content:space-between;
    padding-top:15px;
    font-size:20px;
    font-weight:bold;
}


/* PAYMENT */

.payment-option{
    width:100%;
    background:#f8fafc;
    border:2px solid #e2e8f0;
    padding:15px;
    border-radius:12px;
    margin-bottom:10px;
    text-align:left;
    font-weight:bold;
}

.payment-option.selected{
    border-color:#2563eb;
    background:#eff6ff;
}

.payment-demo{
    margin-top:15px;
    padding:12px;
    background:#fefce8;
    color:#854d0e;
    border-radius:10px;
    font-size:13px;
}


/* TRACKING */

.tracking-status{
    background:#eff6ff;
    color:#1d4ed8;
    padding:15px;
    border-radius:12px;
    margin-bottom:22px;
    font-weight:bold;
}

.tracking-timeline{
    position:relative;
    padding-left:35px;
}

.track-step{
    position:relative;
    padding-bottom:28px;
    color:#94a3b8;
}

.track-step::before{
    content:"";
    position:absolute;
    left:-25px;
    top:3px;
    width:16px;
    height:16px;
    border-radius:50%;
    background:#cbd5e1;
    z-index:2;
}

.track-step::after{
    content:"";
    position:absolute;
    left:-18px;
    top:19px;
    width:2px;
    height:100%;
    background:#e2e8f0;
}

.track-step:last-child::after{
    display:none;
}

.track-step.active{
    color:#2563eb;
    font-weight:bold;
}

.track-step.active::before{
    background:#2563eb;
}

.track-step.completed{
    color:#16a34a;
    font-weight:bold;
}

.track-step.completed::before{
    background:#16a34a;
}


/* HISTORY */

.booking-card{
    background:#f8fafc;
    border:1px solid #e2e8f0;
    padding:17px;
    border-radius:15px;
    margin-bottom:13px;
}

.booking-top{
    display:flex;
    justify-content:space-between;
    gap:10px;
    margin-bottom:10px;
}

.status-badge{
    background:#dbeafe;
    color:#1d4ed8;
    padding:5px 9px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
}

.booking-card p{
    color:#475569;
    margin:7px 0;
    line-height:1.4;
}

.booking-card small{
    color:#94a3b8;
}


/* EMPTY */

.empty-state{
    text-align:center;
    padding:35px 15px;
    color:#64748b;
}


/* PROFILE */

.profile-box{
    text-align:center;
}

.profile-avatar{
    width:80px;
    height:80px;
    border-radius:50%;
    background:#dbeafe;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 15px;
    font-size:38px;
}

.profile-info{
    background:#f8fafc;
    padding:15px;
    border-radius:12px;
    margin-top:15px;
    text-align:left;
}

.profile-info p{
    margin:10px 0;
}


/* BOTTOM NAV */

.bottom-nav{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    height:65px;
    background:white;
    display:flex;
    justify-content:space-around;
    align-items:center;
    box-shadow:0 -3px 15px rgba(0,0,0,.08);
    z-index:20;
}

.nav-btn{
    background:none;
    color:#64748b;
    font-size:12px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:3px;
}

.nav-icon{
    font-size:21px;
}


/* MOBILE */

@media(max-width:500px){

    .container{
        padding:15px;
    }

    .welcome-box{
        padding:20px;
    }

    .category-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .app-section{
        padding:18px;
    }

}

</style>
</head>

<body>


<!-- =========================
     AUTH PAGE
========================= -->

<div id="authPage">

    <div class="auth-card">

        <div class="logo">SC</div>

        <h1>SkillConnect</h1>

        <p class="tagline">
            Find trusted skilled workers near you
        </p>

        <div class="auth-buttons">

            <button
                class="primary-btn"
                onclick="showLogin()">
                Login
            </button>

            <button
                class="secondary-btn"
                onclick="showSignup()">
                Create Account
            </button>

        </div>

    </div>

</div>


<!-- =========================
     LOGIN PAGE
========================= -->

<div id="loginPage" class="form-page">

    <div class="form-card">

        <h2>Login</h2>

        <form onsubmit="loginUser(event)">

            <div class="form-group">
                <label>Email</label>
                <input
                    type="email"
                    id="loginEmail"
                    placeholder="Enter email"
                    required>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input
                    type="password"
                    id="loginPassword"
                    placeholder="Enter password"
                    required>
            </div>

            <div class="form-actions">

                <button
                    type="submit"
                    class="primary-btn">
                    Login
                </button>

                <button
                    type="button"
                    class="back-btn"
                    onclick="showAuth()">
                    Back
                </button>

            </div>

        </form>

    </div>

</div>
<!-- =========================
     SIGNUP PAGE
========================= -->

<div id="signupPage" class="form-page">

    <div class="form-card">

        <h2>Create Account</h2>

        <form onsubmit="signupUser(event)">

            <div class="form-group">
                <label>Full Name</label>

                <input
                    type="text"
                    id="signupName"
                    placeholder="Enter your name"
                    required>
            </div>


            <div class="form-group">
                <label>Email</label>

                <input
                    type="email"
                    id="signupEmail"
                    placeholder="Enter email"
                    required>
            </div>


            <div class="form-group">
                <label>Password</label>

                <input
                    type="password"
                    id="signupPassword"
                    placeholder="Create password"
                    minlength="4"
                    required>
            </div>


            <div class="form-group">

                <label>Account Type</label>

                <select id="signupRole">

                    <option value="Customer">
                        Customer
                    </option>

                    <option value="Worker">
                        Skilled Worker
                    </option>

                </select>

            </div>


            <div class="form-actions">

                <button
                    type="submit"
                    class="primary-btn">
                    Create Account
                </button>

                <button
                    type="button"
                    class="back-btn"
                    onclick="showAuth()">
                    Back
                </button>

            </div>

        </form>

    </div>

</div>



<!-- =========================
     MAIN APP
========================= -->

<div id="appPage">

    <header class="app-header">

        <div class="app-logo">
            SkillConnect
        </div>

        <button
            class="logout-btn"
            onclick="logoutUser()">
            Logout
        </button>

    </header>


    <main class="container">


        <!-- WELCOME -->

        <div
            id="welcomeArea"
            class="welcome-box">

            <h2>
                Welcome to SkillConnect 👋
            </h2>

            <p>
                Find trusted local skilled workers
                for your everyday needs.
            </p>

        </div>


        <!-- SEARCH -->

        <div
            id="searchArea"
            class="search-box">

            <input
                type="text"
                id="serviceSearch"
                placeholder="🔍 Search a service...">

        </div>


        <!-- CATEGORIES -->

        <div id="categoryArea">

            <h2 class="section-title">
                Choose a Service
            </h2>


            <div class="category-grid">


                <div
                    class="category-card"
                    data-service="Electrician"
                    onclick="selectService('Electrician')">

                    <div class="category-icon">⚡</div>

                    <h3>Electrician</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Plumber"
                    onclick="selectService('Plumber')">

                    <div class="category-icon">🚰</div>

                    <h3>Plumber</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Carpenter"
                    onclick="selectService('Carpenter')">

                    <div class="category-icon">🪚</div>

                    <h3>Carpenter</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Painter"
                    onclick="selectService('Painter')">

                    <div class="category-icon">🎨</div>

                    <h3>Painter</h3>

                </div>


                <div
                    class="category-card"
                    data-service="AC RO"
                    onclick="selectService('AC/RO')">

                    <div class="category-icon">❄️</div>

                    <h3>AC / RO</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Barber"
                    onclick="selectService('Barber')">

                    <div class="category-icon">💈</div>

                    <h3>Barber</h3>

                </div>


                <div
                    class="category-card"
                    data-service="DTH"
                    onclick="selectService('DTH')">

                    <div class="category-icon">📡</div>

                    <h3>DTH</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Home Tutor"
                    onclick="selectService('Home Tutor')">

                    <div class="category-icon">👨‍🏫</div>

                    <h3>Home Tutor</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Helper Labour"
                    onclick="selectService('Helper/Labour')">

                    <div class="category-icon">👷</div>

                    <h3>Helper / Labour</h3>

                </div>


                <div
                    class="category-card"
                    data-service="Mistri"
                    onclick="selectService('Mistri')">

                    <div class="category-icon">🏗️</div>

                    <h3>Mistri</h3>

                </div>

            </div>

        </div>


        <!-- PROBLEM REPORT -->

        <section
            id="problemSection"
            class="app-section">

            <h2>Report Your Problem</h2>

            <p class="section-description">
                Tell us what problem you are facing.
                Final diagnosis will be done by the
                worker during physical inspection.
            </p>


            <div class="selected-service">

                Selected Service:
                <span id="selectedService">
                    -
                </span>

            </div>


            <div class="form-group">

                <label>
                    Describe the problem
                </label>

                <textarea
                    id="problemText"
                    placeholder="Example: Fan is not working..."></textarea>

            </div>


            <div class="form-group">

                <label>
                    Preferred Visit Date
                </label>

                <input
                    type="date"
                    id="visitDate">

            </div>


            <button
                class="primary-btn"
                onclick="sendRequest()">

                Send Request

            </button>


            <button
                class="back-btn"
                onclick="backToCategories()"
                style="width:100%;margin-top:10px;">

                Back to Services

            </button>

        </section>



        <!-- WORKER REQUEST -->

        <section
            id="workerSection"
            class="app-section">

            <h2>Worker Request</h2>

            <p class="section-description">
                A nearby verified worker has received
                your service request.
            </p>


            <div class="worker-card">

                <div class="worker-info">

                    <div class="worker-avatar">
                        👨‍🔧
                    </div>

                    <div>

                        <div class="worker-name">
                            Raj Kumar
                        </div>

                        <div class="rating">
                            ⭐ 4.8 • Verified Worker
                        </div>

                    </div>

                </div>


                <p>
                    Experienced local professional
                    available for your selected service.
                </p>


                <div class="action-row">

                    <button
                        class="accept-btn"
                        onclick="acceptRequest()">

                        Accept

                    </button>


                    <button
                        class="reject-btn"
                        onclick="rejectRequest()">

                        Reject

                    </button>

                </div>

            </div>

        </section>
                <!-- INSPECTION -->

        <section
            id="inspectionSection"
            class="app-section">

            <h2>Physical Inspection</h2>

            <p class="section-description">

                Worker will inspect the problem
                physically before giving the final quotation.

            </p>


            <div class="inspection-box">

                <div
                    class="inspection-status"
                    id="inspectionStatus">

                    Inspection Scheduled

                </div>


                <p>
                    👨‍🔧 Worker: Raj Kumar
                </p>

                <p style="margin-top:8px;">
                    📅 Visit:
                    <span id="inspectionDate">
                        Your selected date
                    </span>
                </p>


                <button
                    class="primary-btn"
                    style="margin-top:18px;"
                    onclick="completeInspection()">

                    Complete Inspection

                </button>

            </div>

        </section>



        <!-- QUOTE -->

        <section
            id="quoteSection"
            class="app-section">

            <h2>Fair & Transparent Quotation</h2>

            <p class="section-description">

                Based on physical inspection,
                the worker has prepared an itemized quotation.

            </p>


            <div class="quote-box">


                <div class="quote-item">

                    <span>Service / Labour</span>

                    <span>₹500</span>

                </div>


                <div class="quote-item">

                    <span>Material</span>

                    <span>₹300</span>

                </div>


                <div class="quote-item">

                    <span>Inspection</span>

                    <span>₹50</span>

                </div>


                <div class="quote-total">

                    <span>Total</span>

                    <span>₹850</span>

                </div>


                <div
                    style="margin-top:18px;"
                    class="payment-demo">

                    💡 Customer can approve or reject
                    this quotation before payment.

                </div>


                <div
                    class="action-row"
                    style="margin-top:18px;">

                    <button
                        class="accept-btn"
                        onclick="approveQuote()">

                        Approve Quote

                    </button>


                    <button
                        class="reject-btn"
                        onclick="rejectQuote()">

                        Reject Quote

                    </button>

                </div>

            </div>

        </section>



        <!-- PAYMENT -->

        <section
            id="paymentSection"
            class="app-section">

            <h2>Payment</h2>

            <p class="section-description">

                Select a payment method.
                This prototype uses simulated payment only.

            </p>


            <button
                class="payment-option"
                data-payment="UPI"
                onclick="selectPayment('UPI')">

                📱 UPI

            </button>


            <button
                class="payment-option"
                data-payment="Bank"
                onclick="selectPayment('Bank')">

                🏦 Bank Transfer

            </button>


            <button
                class="payment-option"
                data-payment="Card"
                onclick="selectPayment('Card')">

                💳 Card

            </button>


            <p
                id="selectedPayment"
                style="margin:12px 0;font-weight:bold;">

                No payment method selected

            </p>


            <div class="payment-demo">

                ⚠️ Demo Mode:
                No real money will be transferred.

            </div>


            <button
                class="primary-btn"
                style="margin-top:15px;"
                onclick="makePayment()">

                Pay ₹850

            </button>

        </section>



        <!-- TRACKING -->

        <section
            id="trackingSection"
            class="app-section">

            <h2>Track Your Service</h2>

            <p class="section-description">

                Track the complete service journey.

            </p>


            <div
                id="trackingStatus"
                class="tracking-status">

                Request sent to worker.

            </div>


            <div class="tracking-timeline">


                <div class="track-step active">

                    Request Sent

                </div>


                <div class="track-step">

                    Worker Accepted

                </div>


                <div class="track-step">

                    Inspection Scheduled

                </div>


                <div class="track-step">

                    Inspection Completed

                </div>


                <div class="track-step">

                    Quote Sent

                </div>


                <div class="track-step">

                    Quote Approved

                </div>


                <div class="track-step">

                    Payment

                </div>


                <div class="track-step">

                    Service Completed

                </div>


            </div>


            <button
                id="nextStatusBtn"
                class="primary-btn"
                style="margin-top:10px;"
                onclick="simulateNextStatus()">

                Simulate Next Status

            </button>

        </section>



        <!-- HISTORY -->

        <section
            id="historySection"
            class="app-section">

            <h2>Booking History</h2>

            <p class="section-description">

                Your previous SkillConnect requests.

            </p>


            <div id="bookingHistory">

            </div>

        </section>



        <!-- PROFILE -->

        <section
            id="profileSection"
            class="app-section">

            <h2>My Profile</h2>

            <div class="profile-box">

                <div class="profile-avatar">
                    👤
                </div>


                <h3 id="profileName">
                    User
                </h3>


                <div class="profile-info">

                    <p>
                        <b>Email:</b>
                        <span id="profileEmail">
                        </span>
                    </p>

                    <p>
                        <b>Account:</b>
                        <span id="profileRole">
                        Customer
                        </span>
                    </p>

                </div>

            </div>

        </section>


    </main>



    <!-- BOTTOM NAV -->

    <nav class="bottom-nav">

        <button
            class="nav-btn"
            onclick="goHome()">

            <span class="nav-icon">🏠</span>
            Home

        </button>


        <button
            class="nav-btn"
            onclick="showHistory()">

            <span class="nav-icon">📋</span>
            History

        </button>


        <button
            class="nav-btn"
            onclick="showProfile()">

            <span class="nav-icon">👤</span>
            Profile

        </button>

    </nav>

</div>
<script>

/* =========================================
   SKILLCONNECT JAVASCRIPT
========================================= */

let currentUser = null;
let currentBooking = null;
let currentStage = 0;
let selectedPaymentMethod = "";


/* =========================
   PAGE CONTROL
========================= */

function hideAllPages(){

    document.getElementById("authPage").style.display = "none";

    document.getElementById("loginPage").style.display = "none";

    document.getElementById("signupPage").style.display = "none";

    document.getElementById("appPage").style.display = "none";
}


function showAuth(){

    hideAllPages();

    document.getElementById("authPage").style.display = "flex";
}


function showLogin(){

    hideAllPages();

    document.getElementById("loginPage").style.display = "flex";
}


function showSignup(){

    hideAllPages();

    document.getElementById("signupPage").style.display = "flex";
}


function showApp(){

    hideAllPages();

    document.getElementById("appPage").style.display = "block";

    updateProfileUI();

    showHomeSection();
}


/* =========================
   SIGN UP
========================= */

function signupUser(event){

    event.preventDefault();

    const name =
        document.getElementById("signupName").value.trim();

    const email =
        document.getElementById("signupEmail").value.trim();

    const password =
        document.getElementById("signupPassword").value;

    const role =
        document.getElementById("signupRole").value;


    if(password.length < 4){

        alert("Password must contain at least 4 characters.");

        return;
    }


    const users =
        JSON.parse(
            localStorage.getItem("skillconnectUsers") || "[]"
        );


    const existingUser =
        users.find(function(user){

            return user.email.toLowerCase() ===
                   email.toLowerCase();

        });


    if(existingUser){

        alert("Account already exists. Please login.");

        showLogin();

        return;
    }


    const newUser = {

        id:Date.now(),

        name:name,

        email:email,

        password:password,

        role:role

    };


    users.push(newUser);


    localStorage.setItem(
        "skillconnectUsers",
        JSON.stringify(users)
    );


    currentUser = newUser;


    localStorage.setItem(
        "skillconnectCurrentUser",
        JSON.stringify(currentUser)
    );


    alert("Account created successfully!");


    showApp();
}


/* =========================
   LOGIN
========================= */

function loginUser(event){

    event.preventDefault();


    const email =
        document.getElementById("loginEmail").value.trim();

    const password =
        document.getElementById("loginPassword").value;


    const users =
        JSON.parse(
            localStorage.getItem("skillconnectUsers") || "[]"
        );


    const user =
        users.find(function(item){

            return item.email.toLowerCase() ===
                   email.toLowerCase()
                   &&
                   item.password === password;

        });


    if(!user){

        alert(
            "Invalid email or password.\n" +
            "Please create an account first."
        );

        return;
    }


    currentUser = user;


    localStorage.setItem(
        "skillconnectCurrentUser",
        JSON.stringify(currentUser)
    );


    alert("Login successful!");


    showApp();
}


/* =========================
   LOGOUT
========================= */

function logoutUser(){

    localStorage.removeItem(
        "skillconnectCurrentUser"
    );

    currentUser = null;

    currentBooking = null;

    currentStage = 0;

    selectedPaymentMethod = "";

    showAuth();
}


/* =========================
   APP SECTIONS
========================= */

function hideAppSections(){

    const sections =
        document.querySelectorAll(".app-section");

    sections.forEach(function(section){

        section.style.display = "none";

    });
}


/* =========================
   HOME
========================= */

function showHomeSection(){

    hideAppSections();


    document.getElementById("welcomeArea")
        .style.display = "block";


    document.getElementById("searchArea")
        .style.display = "block";


    document.getElementById("categoryArea")
        .style.display = "block";


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


function goHome(){

    showHomeSection();
}


/* =========================
   SEARCH
========================= */

function searchServices(){

    const input =
        document.getElementById("serviceSearch");

    const value =
        input.value.toLowerCase().trim();


    const cards =
        document.querySelectorAll(".category-card");


    cards.forEach(function(card){

        const service =
            card.getAttribute("data-service")
            .toLowerCase();


        if(service.includes(value)){

            card.style.display = "block";

        }else{

            card.style.display = "none";

        }

    });
}


/* =========================
   SELECT SERVICE
========================= */

function selectService(service){

    document.getElementById("selectedService")
        .textContent = service;


    document.getElementById("welcomeArea")
        .style.display = "none";


    document.getElementById("searchArea")
        .style.display = "none";


    document.getElementById("categoryArea")
        .style.display = "none";


    hideAppSections();


    document.getElementById("problemSection")
        .style.display = "block";


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =========================
   BACK TO CATEGORY
========================= */

function backToCategories(){

    showHomeSection();
}


/* =========================
   SEND REQUEST
========================= */

function sendRequest(){

    const problem =
        document.getElementById("problemText").value.trim();


    if(!problem){

        alert("Please describe your problem first.");

        return;
    }


    saveBooking("Request Sent");


    document.getElementById("problemSection")
        .style.display = "none";


    document.getElementById("workerSection")
        .style.display = "block";


    alert(
        "Service request sent successfully!\n\n" +
        "A nearby worker has received your request."
    );


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =========================
   ACCEPT WORKER
========================= */

function acceptRequest(){

    updateBookingStatus("Worker Accepted");

    currentStage = 1;


    document.getElementById("workerSection")
        .style.display = "none";


    document.getElementById("inspectionSection")
        .style.display = "block";


    const date =
        document.getElementById("visitDate").value;


    document.getElementById("inspectionDate")
        .textContent =
        date || "Schedule with worker";


    alert(
        "Worker accepted your request.\n\n" +
        "Inspection has been scheduled."
    );
}


/* =========================
   REJECT WORKER
========================= */

function rejectRequest(){

    updateBookingStatus("Request Rejected");


    alert(
        "Request rejected.\n" +
        "You can choose another service."
    );


    showHomeSection();
}


/* =========================
   INSPECTION
========================= */

function completeInspection(){

    updateBookingStatus(
        "Inspection Completed"
    );


    currentStage = 3;


    document.getElementById("inspectionSection")
        .style.display = "none";


    document.getElementById("quoteSection")
        .style.display = "block";


    alert(
        "Physical inspection completed.\n\n" +
        "Worker has prepared an itemized quotation."
    );
}


/* =========================
   QUOTE
========================= */

function approveQuote(){

    updateBookingStatus(
        "Quote Approved"
    );


    currentStage = 5;


    document.getElementById("quoteSection")
        .style.display = "none";


    document.getElementById("paymentSection")
        .style.display = "block";


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


function rejectQuote(){

    updateBookingStatus(
        "Quote Rejected"
    );


    alert(
        "Quotation rejected.\n" +
        "You can choose another service."
    );


    showHomeSection();
}


/* =========================
   PAYMENT
========================= */

function selectPayment(method){

    selectedPaymentMethod = method;


    const buttons =
        document.querySelectorAll(".payment-option");


    buttons.forEach(function(button){

        button.classList.remove("selected");

    });


    const selectedButton =
        document.querySelector(
            '[data-payment="' + method + '"]'
        );


    if(selectedButton){

        selectedButton.classList.add("selected");

    }


    document.getElementById(
        "selectedPayment"
    ).textContent =
        "Selected: " + method;
}


function makePayment(){

    if(!currentBooking){

        alert("No active booking found.");

        return;
    }


    if(!selectedPaymentMethod){

        alert(
            "Please select a payment method first."
        );

        return;
    }


    updateBookingStatus("Payment");


    currentStage = 6;


    alert(
        "Demo Payment Successful! 🎉\n\n" +
        "Method: " +
        selectedPaymentMethod +
        "\n\n" +
        "No real money was transferred."
    );


    document.getElementById("paymentSection")
        .style.display = "none";


    showTracking();

    updateTimeline();
}


/* =========================
   TRACKING
========================= */

function showTracking(){

    hideAppSections();


    document.getElementById(
        "trackingSection"
    ).style.display = "block";


    updateTimeline();


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


function updateTimeline(){

    const steps =
        document.querySelectorAll(".track-step");


    steps.forEach(function(step,index){

        step.classList.remove("completed");

        step.classList.remove("active");


        if(index < currentStage){

            step.classList.add("completed");

        }


        if(index === currentStage){

            step.classList.add("active");

        }

    });


    const messages = [

        "Request sent to worker.",

        "Worker accepted your request.",

        "Inspection has been scheduled.",

        "Inspection completed.",

        "Quotation has been sent.",

        "Quotation approved.",

        "Payment completed.",

        "Service completed successfully."

    ];


    document.getElementById(
        "trackingStatus"
    ).textContent =
        messages[currentStage];


    const button =
        document.getElementById("nextStatusBtn");


    if(currentStage >= 7){

        button.textContent =
            "Service Completed";

        button.disabled = true;

    }else{

        button.textContent =
            "Simulate Next Status";

        button.disabled = false;

    }
}


function simulateNextStatus(){

    if(!currentBooking){

        alert(
            "Please create a booking first."
        );

        return;
    }


    if(currentStage < 7){

        currentStage++;


        const statusNames = [

            "Request Sent",

            "Worker Accepted",

            "Inspection Scheduled",

            "Inspection Completed",

            "Quote Sent",

            "Quote Approved",

            "Payment",

            "Service Completed"

        ];


        updateBookingStatus(
            statusNames[currentStage]
        );


        updateTimeline();


        if(currentStage === 7){

            alert(
                "🎉 Service Completed Successfully!"
            );

        }

    }
}


/* =========================
   BOOKING STORAGE
========================= */

function getBookings(){

    return JSON.parse(
        localStorage.getItem(
            "skillconnectBookings"
        ) || "[]"
    );
}


function saveBooking(status){

    const service =
        document.getElementById(
            "selectedService"
        ).textContent;


    const problem =
        document.getElementById(
            "problemText"
        ).value;


    const visitDate =
        document.getElementById(
            "visitDate"
        ).value;


    const booking = {

        id:Date.now(),

        service:service,

        problem:problem,

        visitDate:visitDate,

        status:status,

        customer:
            currentUser ?
            currentUser.name :
            "Customer",

        date:
            new Date().toLocaleString()

    };


    currentBooking = booking;


    const bookings =
        getBookings();


    bookings.unshift(booking);


    localStorage.setItem(
        "skillconnectBookings",
        JSON.stringify(bookings)
    );
}


function updateBookingStatus(status){

    if(!currentBooking){

        return;
    }


    currentBooking.status = status;


    const bookings =
        getBookings();


    const index =
        bookings.findIndex(function(item){

            return item.id ===
                   currentBooking.id;

        });


    if(index !== -1){

        bookings[index] =
            currentBooking;


        localStorage.setItem(
            "skillconnectBookings",
            JSON.stringify(bookings)
        );
    }
}


/* =========================
   HISTORY
========================= */

function showHistory(){

    hideAppSections();


    document.getElementById("welcomeArea")
        .style.display = "none";


    document.getElementById("searchArea")
        .style.display = "none";


    document.getElementById("categoryArea")
        .style.display = "none";


    document.getElementById("historySection")
        .style.display = "block";


    renderBookings();
}


function renderBookings(){

    const container =
        document.getElementById(
            "bookingHistory"
        );


    const bookings =
        getBookings();


    if(bookings.length === 0){

        container.innerHTML = `
            <div class="empty-state">
                <h3>No bookings yet</h3>
                <p>
                    Your SkillConnect bookings
                    will appear here.
                </p>
            </div>
        `;

        return;
    }


    container.innerHTML = "";


    bookings.forEach(function(booking){

        const card =
            document.createElement("div");


        card.className =
            "booking-card";


        card.innerHTML = `

            <div class="booking-top">

                <strong>
                    ${booking.service}
                </strong>

                <span class="status-badge">
                    ${booking.status}
                </span>

            </div>


            <p>
                <b>Problem:</b>
                ${booking.problem || "Not specified"}
            </p>


            <p>
                <b>Visit:</b>
                ${booking.visitDate || "Not scheduled"}
            </p>


            <small>
                ${booking.date}
            </small>

        `;


        container.appendChild(card);

    });
}


/* =========================
   PROFILE
========================= */

function showProfile(){

    hideAppSections();


    document.getElementById("welcomeArea")
        .style.display = "none";


    document.getElementById("searchArea")
        .style.display = "none";


    document.getElementById("categoryArea")
        .style.display = "none";


    document.getElementById("profileSection")
        .style.display = "block";


    updateProfileUI();
}


function updateProfileUI(){

    if(!currentUser){

        return;
    }


    document.getElementById(
        "profileName"
    ).textContent =
        currentUser.name;


    document.getElementById(
        "profileEmail"
    ).textContent =
        currentUser.email;


    document.getElementById(
        "profileRole"
    ).textContent =
        currentUser.role;
}


/* =========================
   START APP
========================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        const savedUser =
            localStorage.getItem(
                "skillconnectCurrentUser"
            );


        if(savedUser){

            try{

                currentUser =
                    JSON.parse(savedUser);

                showApp();

            }catch(error){

                localStorage.removeItem(
                    "skillconnectCurrentUser"
                );

                showAuth();
            }

        }else{

            showAuth();

        }


        const search =
            document.getElementById(
                "serviceSearch"
            );


        if(search){

            search.addEventListener(
                "input",
                searchServices
            );

        }

    }
);

</script>

</body>
</html>