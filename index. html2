/* ================= TRACK ================= */

function loadTrack(){

let box =
document.getElementById("trackBox");

let saved =
localStorage.getItem("skillconnectBooking");

if(!saved){

box.innerHTML =
"<p style='text-align:center'>No active booking.</p>";

return;

}

let d = JSON.parse(saved);

let statusText = "Booking Requested 📩";

if(d.status === "Accepted"){
statusText = "Worker Accepted ✅";
}

if(d.status === "Paid"){
statusText = "Payment Successful 💳";
}

if(d.status === "Rejected"){
statusText = "Booking Rejected ❌";
}

box.innerHTML = `

<div class="booking">

<h2>${statusText}</h2>

<p>
👷 Worker:
<b>${d.worker}</b>
</p>

<p>
⚒️ Service:
<b>${d.skill}</b>
</p>

<p>
📍 ${d.location}
</p>

<p>
📅 ${d.date}
</p>

<hr>

<div class="flow">
1️⃣ Booking Requested
</div>

<div class="flow">
2️⃣ Worker Response
</div>

<div class="flow">
3️⃣ Payment
</div>

<div class="flow">
4️⃣ Service Confirmed
</div>

</div>

`;

}


