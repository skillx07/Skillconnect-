<script>

let accountRole = "Customer";

let currentUser = {
  name:"Anshu Kumar",
  email:"demo@gmail.com",
  mobile:"8757999643",
  role:"Customer"
};

let selectedService = "";
let selectedWorker = null;
let bookingData = null;


/* ================= WORKERS ================= */

const workers = {

"Electrician":{
 name:"Ravi Kumar",
 skill:"Electrician",
 location:"Supaul",
 mobile:"9876500001"
},

"Plumber":{
 name:"Amit Kumar",
 skill:"Plumber",
 location:"Supaul",
 mobile:"9876500002"
},

"Carpenter":{
 name:"Rakesh Kumar",
 skill:"Carpenter",
 location:"Patna",
 mobile:"9876500003"
},

"Painter":{
 name:"Sanjay Kumar",
 skill:"Painter",
 location:"Darbhanga",
 mobile:"9876500004"
},

"Mechanic":{
 name:"Vikas Kumar",
 skill:"Mechanic",
 location:"Saharsa",
 mobile:"9876500005"
},

"Barber":{
 name:"Manoj Kumar",
 skill:"Barber",
 location:"Supaul",
 mobile:"9876500006"
},

"AC Technician":{
 name:"Deepak Kumar",
 skill:"AC Technician",
 location:"Patna",
 mobile:"9876500007"
},

"Home Tutor":{
 name:"Neha Kumari",
 skill:"Home Tutor",
 location:"Darbhanga",
 mobile:"9876500008"
},

"Mobile Repair":{
 name:"Rahul Kumar",
 skill:"Mobile Repair",
 location:"Saharsa",
 mobile:"9876500009"
},

"Mason":{
 name:"Pankaj Kumar",
 skill:"Mason",
 location:"Supaul",
 mobile:"9876500010"
},

"DTH Technician":{
 name:"Sunil Kumar",
 skill:"DTH Technician",
 location:"Supaul",
 mobile:"9876500011"
},

"Labour":{
 name:"Raj Kumar",
 skill:"Labour",
 location:"Supaul",
 mobile:"9876500012"
}

};


/* ================= PAGE ================= */

function showPage(id){

document.querySelectorAll("section").forEach(function(x){
x.classList.add("hide");
});

let page = document.getElementById(id);

if(page){
page.classList.remove("hide");
}

window.scrollTo(0,0);

}


/* ================= ROLE ================= */

function setRole(role){

accountRole = role;

let customer = document.getElementById("customerRole");
let worker = document.getElementById("workerRole");
let fields = document.getElementById("workerFields");

if(role === "Customer"){

customer.className = "active";
worker.className = "inactive";
fields.classList.add("hide");

}else{

worker.className = "active";
customer.className = "inactive";
fields.classList.remove("hide");

}

}


/* ================= CREATE ACCOUNT ================= */

function createAccount(){

let name = document.getElementById("regName").value.trim();
let email = document.getElementById("regEmail").value.trim();
let mobile = document.getElementById("regMobile").value.trim();
let password = document.getElementById("regPassword").value.trim();

if(!name || !email || !mobile || !password){

document.getElementById("registerMsg").innerHTML =
"<div class='err'>Please fill all details.</div>";

return;

}

if(password.length < 4){

document.getElementById("registerMsg").innerHTML =
"<div class='err'>Password must be at least 4 characters.</div>";

return;

}


/* WORKER */

if(accountRole === "Worker"){

let skill = document.getElementById("regSkill").value;

let location = document.getElementById("regLocation").value.trim();

if(!skill || !location){

document.getElementById("registerMsg").innerHTML =
"<div class='err'>Please select skill and location.</div>";

return;

}

currentUser = {

name:name,
email:email,
mobile:mobile,
role:"Worker",
skill:skill,
location:location

};

localStorage.setItem(
"skillconnectUser",
JSON.stringify(currentUser)
);

updateWorkerProfile();

document.getElementById("registerMsg").innerHTML =
"<div class='ok'>Worker account created successfully 🎉</div>";

setTimeout(function(){

showPage("worker");

loadWorkerRequest();

},500);

return;

}


/* CUSTOMER */

currentUser = {

name:name,
email:email,
mobile:mobile,
role:"Customer"

};

localStorage.setItem(
"skillconnectUser",
JSON.stringify(currentUser)
);

updateCustomerProfile();

document.getElementById("registerMsg").innerHTML =
"<div class='ok'>Customer account created successfully 🎉</div>";

setTimeout(function(){

showPage("customer");

},500);

}


/* ================= LOGIN ================= */

function login(){

let email =
document.getElementById("loginEmail").value.trim();

let password =
document.getElementById("loginPassword").value.trim();

let role =
document.getElementById("loginRole").value;

if(!email || !password){

document.getElementById("loginMsg").innerHTML =
"<div class='err'>Enter email and password.</div>";

return;

}


/* CUSTOMER LOGIN */

if(role === "Customer"){

currentUser = {

name:"Anshu Kumar",
email:email,
mobile:"8757999643",
role:"Customer"

};

localStorage.setItem(
"skillconnectUser",
JSON.stringify(currentUser)
);

updateCustomerProfile();

showPage("customer");

return;

}


/* WORKER LOGIN */

currentUser = {

name:"Ravi Kumar",
email:email,
mobile:"9876500001",
role:"Worker",
skill:"Electrician",
location:"Supaul"

};

localStorage.setItem(
"skillconnectUser",
JSON.stringify(currentUser)
);

updateWorkerProfile();

loadWorkerRequest();

showPage("worker");

}


/* ================= CUSTOMER PROFILE ================= */

function updateCustomerProfile(){

let x = document.getElementById("customerName");

if(x){
x.innerText = currentUser.name;
}

document.getElementById("profileName").innerText =
currentUser.name;

document.getElementById("profileEmail").innerText =
currentUser.email;

document.getElementById("profileMobile").innerText =
currentUser.mobile;

document.getElementById("profileRole").innerText =
"Customer";

}


/* ================= WORKER PROFILE ================= */

function updateWorkerProfile(){

document.getElementById("workerName").innerText =
currentUser.name;

document.getElementById("workerSkill").innerText =
currentUser.skill || "Electrician";

document.getElementById("workerLocation").innerText =
currentUser.location || "Supaul";

document.getElementById("profileName").innerText =
currentUser.name;

document.getElementById("profileEmail").innerText =
currentUser.email;

document.getElementById("profileMobile").innerText =
currentUser.mobile;

document.getElementById("profileRole").innerText =
"Worker";

}


/* ================= SELECT SERVICE ================= */

function selectService(service){

selectedService = service;

selectedWorker = workers[service];

let w = selectedWorker;

document.getElementById("workers").innerHTML = `

<div class="worker">

<h3>👷 ${w.name}</h3>

<p>⚒️ <b>${w.skill}</b></p>

<p>📍 ${w.location}</p>

<p>📞 ${w.mobile}</p>

<p>
<span class="badge">
✓ Verified & Available
</span>
</p>

<button onclick="openBooking()">
📅 Book Service
</button>

</div>

`;

}


/* ================= BOOKING PAGE ================= */

function openBooking(){

if(!selectedWorker){

alert("Please select a worker first.");

return;

}

let w = selectedWorker;

document.getElementById("bookingWorker").innerHTML = `

<div class="worker">

<h3>👷 ${w.name}</h3>

<p>⚒️ ${w.skill}</p>

<p>📍 ${w.location}</p>

<p>📞 ${w.mobile}</p>

<span class="badge">
✓ Verified Worker
</span>

</div>

`;

document.getElementById("serviceLocation").value = "";
document.getElementById("problem").value = "";
document.getElementById("bookingDate").value = "";
document.getElementById("amount").value = "500";
document.getElementById("bookingMsg").innerHTML = "";

showPage("booking");

}


/* ================= SEND BOOKING ================= */

function sendBooking(){

if(!selectedWorker){

alert("Please select worker.");

return;

}

let location =
document.getElementById("serviceLocation").value.trim();

let problem =
document.getElementById("problem").value.trim();

let date =
document.getElementById("bookingDate").value;

let amount =
Number(document.getElementById("amount").value);

if(!location || !problem || !date || !amount){

document.getElementById("bookingMsg").innerHTML =
"<div class='err'>Please fill all booking details.</div>";

return;

}

bookingData = {

customer:currentUser.name,
mobile:currentUser.mobile,

worker:selectedWorker.name,
skill:selectedWorker.skill,

location:location,
problem:problem,
date:date,
amount:amount,

status:"Pending"

};

localStorage.setItem(
"skillconnectBooking",
JSON.stringify(bookingData)
);

document.getElementById("bookingMsg").innerHTML = `

<div class="ok">

Booking request sent to
<b>${selectedWorker.name}</b> 📩

</div>

`;

setTimeout(function(){

loadWorkerRequest();

showPage("worker");

},700);

}


/* ================= WORKER REQUEST ================= */

function loadWorkerRequest(){

let saved =
localStorage.getItem("skillconnectBooking");

let box =
document.getElementById("workerRequest");

if(!box) return;

if(!saved){

box.innerHTML =
"<p style='text-align:center'>No booking requests yet.</p>";

return;

}

bookingData = JSON.parse(saved);

let d = bookingData;


/* PAID */

if(d.status === "Paid"){

box.innerHTML = `

<div class="ok">

✅ Booking completed<br>
💰 Payment received

</div>

`;

return;

}


/* REJECTED */

if(d.status === "Rejected"){

box.innerHTML = `

<div class="err">

❌ Booking request rejected.

</div>

`;

return;

}


/* REQUEST */

box.innerHTML = `

<div class="booking">

<h3>📩 New Booking Request</h3>

<p>
👤 Customer:
<b>${d.customer}</b>
</p>

<p>📞 ${d.mobile}</p>

<p>
⚒️ Service:
<b>${d.skill}</b>
</p>

<p>📍 ${d.location}</p>

<p>🛠️ ${d.problem}</p>

<p>📅 ${d.date}</p>

<p>
💰 Amount:
<b>₹${d.amount}</b>
</p>

<div class="status">
Status: ${d.status}
</div>

<button class="success"
onclick="acceptBooking()">

✅ Accept Booking

</button>

<button class="danger"
onclick="rejectBooking()">

❌ Reject Booking

</button>

</div>

`;

}


/* ================= ACCEPT ================= */

function acceptBooking(){

if(!bookingData){

return;

}

bookingData.status = "Accepted";

localStorage.setItem(
"skillconnectBooking",
JSON.stringify(bookingData)
);

document.getElementById("paymentDetails").innerHTML = `

<div class="booking">

<p>
👤 Customer:
<b>${bookingData.customer}</b>
</p>

<p>
👷 Worker:
<b>${bookingData.worker}</b>
</p>

<p>
