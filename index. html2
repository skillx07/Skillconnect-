<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#f3f7ff;
 color:#172033;
 padding-bottom:75px;
}

.container{
 max-width:720px;
 margin:auto;
 padding:16px;
}

.card{
 background:#fff;
 border-radius:22px;
 padding:22px;
 margin-bottom:15px;
 box-shadow:0 6px 25px #0001;
}

.hide{display:none!important}

h1{
 text-align:center;
 color:#2864df;
}

h2{text-align:center}

p{color:#667085}

button{
 width:100%;
 padding:14px;
 margin:7px 0;
 border:0;
 border-radius:12px;
 background:#2864df;
 color:white;
 font-size:16px;
 font-weight:bold;
}

.back{
 background:#edf3ff;
 color:#2864df;
}

.success{background:#20a05a}
.danger{background:#e74c3c}
.warning{background:#f39c12}

input,select,textarea{
 width:100%;
 padding:14px;
 margin:7px 0 14px;
 border:1px solid #ccd5e3;
 border-radius:12px;
 font-size:16px;
}

.role{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
}

.role button{margin:0}

.active{
 background:#2864df;
 color:white;
}

.inactive{
 background:#edf3ff;
 color:#2864df;
}

.category-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin:15px 0;
}

.category{
 padding:16px 5px;
 border-radius:15px;
 background:#f3f7ff;
 border:1px solid #dce5f2;
 text-align:center;
 font-weight:bold;
 cursor:pointer;
}

.category span{
 display:block;
 font-size:28px;
 margin-bottom:5px;
}

.worker,.booking{
 padding:16px;
 margin:12px 0;
 border-radius:15px;
 background:#f8faff;
 border:1px solid #e1e7f2;
}

.badge{
 display:inline-block;
 padding:6px 10px;
 border-radius:20px;
 background:#eaf1ff;
 color:#2864df;
 font-weight:bold;
}

.ok{
 background:#e8f8ed;
 color:#16803c;
 padding:13px;
 border-radius:10px;
 margin:10px 0;
 text-align:center;
}

.err{
 background:#ffe9e9;
 color:#c62828;
 padding:13px;
 border-radius:10px;
 margin:10px 0;
 text-align:center;
}

.status{
 text-align:center;
 padding:12px;
 border-radius:12px;
 background:#eef3ff;
 margin:12px 0;
 font-weight:bold;
}

.amount{
 font-size:30px;
 font-weight:bold;
 text-align:center;
 color:#2864df;
 margin:20px;
}

.flow{
 padding:12px;
 margin:7px 0;
 background:#f7f9ff;
 border-left:5px solid #2864df;
 border-radius:9px;
}

.bottom{
 position:fixed;
 bottom:0;
 left:0;
 right:0;
 height:68px;
 background:white;
 box-shadow:0 -3px 15px #0002;
 display:flex;
 z-index:1000;
}

.bottom button{
 flex:1;
 background:white;
 color:#475467;
 margin:0;
 padding:6px 2px;
 font-size:11px;
 border-radius:0;
}

.bottom span{
 display:block;
 font-size:22px;
 margin-bottom:3px;
}

hr{
 border:0;
 border-top:1px solid #e5e9f2;
 margin:20px 0;
}
</style>
</head>

